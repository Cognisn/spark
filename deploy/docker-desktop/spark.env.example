# Example environment for deploy/docker-desktop/compose.yaml. Copy it to
# spark.env in the same folder (not committed) and replace every value ending
# in -dev-only.

# The image: pin the version you are trying (there is no latest tag), or the tag
# of an image you built yourself, for example spark:0.3.0rc1.
SPARK_IMAGE=ghcr.io/cognisn/spark:0.3.0rc1

# The database owner the postgres container creates on first start. Spark's
# database URL is built from these, so use only letters, digits, - and _ in the
# password.
POSTGRES_USER=spark
POSTGRES_PASSWORD=spark-db-password-dev-only
POSTGRES_DB=spark

# Key for konfig's encrypted secrets file (provider keys and other secrets you
# enter in Spark). Generate one with the image itself:
#   docker run --rm --entrypoint python ghcr.io/cognisn/spark:0.3.0rc1 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KONFIG_MASTER_KEY=replace-with-a-generated-key-dev-only

# The address you open in the browser. Keep the default with the web port below,
# or use https://localhost:8443 with the https profile.
SPARK_PUBLIC_BASE_URL=http://localhost:8000
SPARK_WEB_PORT=8000
