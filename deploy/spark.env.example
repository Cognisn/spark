# Example environment for deploy/compose.yaml. Copy it to deploy/spark.env (not
# committed) and replace every value ending in -dev-only before real use.

# PostgreSQL (read by the postgres service).
POSTGRES_USER=spark
POSTGRES_PASSWORD=spark-db-password-dev-only
POSTGRES_DB=spark

# Spark's database URL: the same credentials, host "postgres". Percent-encode
# any special characters in the password.
SPARK__DATABASE__URL=postgresql://spark:spark-db-password-dev-only@postgres:5432/spark

# Key for konfig's encrypted secrets file (provider keys and other secrets entered
# in Spark). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KONFIG_MASTER_KEY=replace-with-a-generated-key-dev-only

# Any other setting can be given as SPARK__<SECTION>__<KEY>, for example:
# SPARK__LOGGING__LEVEL=INFO
# SPARK__AUTONOMOUS_ACTIONS__ENABLED=true
