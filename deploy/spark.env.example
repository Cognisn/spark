# Example environment for deploy/compose.yaml. Copy it to deploy/spark.env (not
# committed) and replace every value ending in -dev-only or CHANGEME before real use.

# PostgreSQL (read by the postgres service). POSTGRES_USER owns the schema; only
# migrate and bootstrap connect as it.
POSTGRES_USER=spark
POSTGRES_PASSWORD=spark-db-password-dev-only
POSTGRES_DB=spark

# Spark's database URL: the same credentials, host "postgres". Percent-encode
# any special characters in the password.
SPARK__DATABASE__URL=postgresql://spark:spark-db-password-dev-only@postgres:5432/spark

# The address users reach Spark on (required in server mode): https, the host
# name of the TLS reverse proxy in front of the web container, and no path.
SPARK__SERVER__PUBLIC_BASE_URL=https://spark.example.com

# Key for konfig's encrypted secrets file (provider keys and other secrets entered
# in Spark). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KONFIG_MASTER_KEY=replace-with-a-generated-key-dev-only

# The first administrator, invited by spark bootstrap on the first start
# (docs/deployment/identity.md). Required.
SPARK__BOOTSTRAP__ADMIN__EMAIL=CHANGEME@example.com
SPARK__BOOTSTRAP__ADMIN__FIRST_NAME=CHANGEME
SPARK__BOOTSTRAP__ADMIN__LAST_NAME=CHANGEME

# Mail for invitations and password resets: stored as the instance's mail settings
# on the first start, then changed on the instance settings page. These send to the
# Compose file's mail catcher (inbox at http://127.0.0.1:8025); for a real mail
# server use its host, port 587 with starttls (or 465 with implicit), and put its
# password in the secrets store as mail_smtp_password (docs/deployment/secrets.md).
SPARK__MAIL__SMTP__HOST=127.0.0.1
SPARK__MAIL__SMTP__PORT=1025
SPARK__MAIL__SMTP__TLS=none
SPARK__MAIL__SMTP__SENDER_ADDRESS=spark@example.com
SPARK__MAIL__SMTP__SENDER_NAME=Spark

# Restricted database logins, so the audit trail is append-only in the database
# (docs/deployment/database.md). bootstrap creates each login from its URL, with
# the password in it. To use them, also give web and worker these URLs as their
# own SPARK__DATABASE__URL (deploy/compose.roles.yaml in that guide).
# SPARK__BOOTSTRAP__DATABASE__WEB_URL=postgresql://spark_web:CHANGEME-web-dev-only@postgres:5432/spark
# SPARK__BOOTSTRAP__DATABASE__WORKER_URL=postgresql://spark_worker:CHANGEME-worker-dev-only@postgres:5432/spark
# With an audit retention (SPARK__WARDEN__AUDIT__RETENTION_DAYS), the purge's own login:
# SPARK__WORKER__AUDIT_PURGE_DATABASE_URL=postgresql://spark_purger:CHANGEME-purger-dev-only@postgres:5432/spark

# Any other setting can be given as SPARK__<SECTION>__<KEY>, for example:
# SPARK__LOGGING__LEVEL=INFO
# SPARK__AUTONOMOUS_ACTIONS__ENABLED=true
