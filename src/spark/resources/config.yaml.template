# =============================================================================
# Spark Configuration
# =============================================================================
# Copy this file to config.yaml and customise for your environment.
# Secrets can be referenced using secret:// URIs, e.g.:
#   api_key: secret://connections.work-claude.api_key
# Secret names include their group (database.url is stored as database_url).
# Environment variables override settings using the SPARK__ prefix, e.g.:
#   SPARK__MODE=server
# =============================================================================

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
logging:
  level: INFO                    # DEBUG, INFO, WARNING, ERROR, CRITICAL
  format: text                   # text or json
  retention_runs: 10             # Number of historical log directories to keep
  max_file_size_mb: 50           # Rotate log file at this size
  max_files_per_run: 3           # Rotated files per run directory
  console_output: auto           # auto, stderr, or none

# -----------------------------------------------------------------------------
# Mode
# -----------------------------------------------------------------------------
# personal: one local user, SQLite in the platform data directory (default)
# server:   multi-user, PostgreSQL; requires database.url
mode: personal

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Personal mode always uses SQLite in the platform data directory.
# Server mode requires a PostgreSQL URL, for example:
#   url: postgresql://spark@db.example.com:5432/spark
# or the environment variable SPARK__DATABASE__URL. MySQL and SQL Server are
# no longer supported.
database:
  type: sqlite
  # url: postgresql://spark@db.example.com:5432/spark
  # A URL holding a password belongs in the secrets store instead:
  # url: secret://database_url

# -----------------------------------------------------------------------------
# Server mode
# -----------------------------------------------------------------------------
# The address users reach Spark on in server mode, for example
# https://spark.example.com (required in server mode; https unless the host is
# loopback; no path). Sign-in cookies, the Origin check and every link Spark
# sends are built from it. In server mode administrators manage model
# connections (with their models, metering and assignments) on the Connections
# page, and MCP servers, tool policy and integrations on the settings page; all
# of it is kept in the database, not in this file.
server:
  public_base_url: ""

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# Secrets are kept by konfig, never in this file or the database. Personal mode
# uses the OS keychain. Server mode uses either konfig's encrypted store (one
# file shared by every replica, opened with the KONFIG_MASTER_KEY environment
# variable) or AWS Secrets Manager (set KONFIG_AWS_SECRETS_MANAGER to the ARN of
# one secret holding a JSON bundle, or use backend: aws_secrets_manager).
# secrets:
#   backend: encrypted_file        # or aws_secrets_manager; required in server mode
#   file_path: /var/lib/spark/secrets.enc

# -----------------------------------------------------------------------------
# warden (identity and audit, server mode only)
# -----------------------------------------------------------------------------
# warden runs inside Spark. Its public address and screen links come from
# server.public_base_url, so do not set warden.http. Everything else is
# optional; the defaults are warden's own. A value may be secret://<name>.
# warden:
#   identity:
#     require_mfa: true
#     access_token_ttl_seconds: 900
#     session_lifespan_seconds: 43200
#   audit:
#     trusted_proxies: 10.0.0.0/8

# -----------------------------------------------------------------------------
# Web Interface
# -----------------------------------------------------------------------------
interface:
  host: 127.0.0.1
  # TCP port for the web interface. 0 (default) picks a random free port each
  # launch. Set a fixed port for a headless/server or reverse-proxy setup.
  port: 0
  # Open the browser automatically at startup. Set false for a headless run
  # (e.g. `uv tool install cognisn-spark` on a server).
  open_browser: true
  ssl:
    enabled: false
    # cert_file: /path/to/cert.pem
    # key_file: /path/to/key.pem
    # auto_generate: true          # Generate self-signed cert if none provided
  session_timeout_minutes: 60
  session_max_age_hours: 24        # End a session this long after sign-in
  login:
    code_ttl_seconds: 300          # A sign-in code works once, within this time
    max_failures: 5                # Failed sign-ins per address within the window
    failure_window_seconds: 300
    lockout_seconds: 900           # Lock-out after max_failures
  # allowed_origins:               # Further origins, e.g. behind a reverse proxy
  #   - https://spark.example.com
  browser_heartbeat:
    enabled: true
    interval_seconds: 30
    miss_threshold: 3              # Shutdown after N missed heartbeats

# -----------------------------------------------------------------------------
# Model Connections
# -----------------------------------------------------------------------------
# Each connection is one named service with its own settings: several of one
# kind may sit side by side. A model is chosen as <connection id>/<model id>.
# Credentials are never written here: each is a secret:// reference to the OS
# keychain. The models offered are those conduit's catalogue declares for the
# connection's kind and Region, unless a connection lists its own "models".
# Residency: in-Region for Bedrock and Microsoft Foundry, global for direct
# APIs, local for Ollama, unless a connection sets its own.
connections: []
#  - id: work-claude
#    name: Work Claude
#    settings:
#      kind: anthropic
#      api_key: secret://connections.work-claude.api_key
#  - id: sydney-bedrock
#    name: Bedrock (Sydney)
#    settings:
#      kind: bedrock
#      region: ap-southeast-2
#      auth: {mode: credential_chain, profile: default}
#    residency: {scopes: [local, in_region], regions: [ap-southeast-2]}
#  - id: home-ollama
#    name: Home Ollama
#    settings:
#      kind: ollama
#      base_url: http://localhost:11434
#    models:
#      - {id: llama3.1:8b, enabled: true, tier: standard}

# -----------------------------------------------------------------------------
# Conversation Settings
# -----------------------------------------------------------------------------
conversation:
  # Context compaction
  rollup_threshold: 0.3           # Compact at 30% of context window
  rollup_summary_ratio: 0.3       # Compress to 30% of original
  emergency_rollup_threshold: 0.95 # Force compaction at 95%

  # Tool execution
  max_tool_iterations: 25
  max_tool_result_tokens: 4000

  # Web search (Anthropic models)
  web_search:
    enabled: false

  # Global system instructions (prepended to all conversations)
  # global_instructions: |
  #   You are a helpful AI assistant.

  # Prompt caching: caches system prompts and tool definitions to reduce input costs,
  # where the model supports it (conduit's catalogue). Default: true.
  prompt_caching: true

# -----------------------------------------------------------------------------
# Token Management
# -----------------------------------------------------------------------------
# No code reads this section. Usage limits are monthly credit allowances on a
# server's metered connections, set on the Connections page.
token_management:
  # enabled: false
  # limit: 1000000                  # Max tokens per rolling window
  # window_hours: 24                # Rolling window duration

# -----------------------------------------------------------------------------
# Security — Prompt Inspection
# -----------------------------------------------------------------------------
prompt_inspection:
  enabled: false
  # level: standard                 # basic, standard, strict
  # action: warn                    # block, warn, sanitize, log_only

# -----------------------------------------------------------------------------
# Tool Permissions
# -----------------------------------------------------------------------------
tool_permissions:
  auto_approve: false               # Prompt user for each new tool

# -----------------------------------------------------------------------------
# MCP Servers
# -----------------------------------------------------------------------------
# mcp:
#   servers:
#     - name: example-server
#       transport: stdio
#       command: npx
#       args: ["-y", "@example/mcp-server"]
#       # env:
#       #   API_KEY: secret://example_api_key

# -----------------------------------------------------------------------------
# Embedded Tools
# -----------------------------------------------------------------------------
embedded_tools:
  filesystem:
    enabled: true
    mode: read                     # read or read_write
    allowed_paths: []              # Empty = working directory only

  documents:
    enabled: true
    mode: read                     # read or read_write
    max_file_size_mb: 50

  archives:
    enabled: true
    mode: list                     # list or extract

  web:
    enabled: true
    search_engine: duckduckgo        # duckduckgo, brave, google, bing, searxng
    # brave_api_key: ""              # Brave Search API key (free tier at search.brave.com/api)
    # google_api_key: ""             # SerpAPI key (serpapi.com)
    # bing_api_key: ""               # Azure Cognitive Services Bing Search key
    # searxng_url: ""                # SearXNG instance URL, e.g. https://search.example.com

  # Results from external sources always reach the model as marked, untrusted
  # data. When one matches prompt injection patterns, Spark marks it, warns the
  # model about it, or withholds it (the model is told it was withheld and why).
  # tool_results:
  #   web: warn                      # mark, warn or withhold
  #   mcp: warn
  #   documents: warn                # documents and archives
  #   agents: warn                   # sub-agent results
  #   files: warn                    # files read from disk (filesystem tools)
  #   commands: warn                 # system command output

# -----------------------------------------------------------------------------
# Default Model
# -----------------------------------------------------------------------------
# default_model:
#   model_id: home-ollama/llama3.1:8b  # <connection id>/<model id> to pre-select for new conversations
#   mode: default                       # default = pre-selected, mandatory = locked

# -----------------------------------------------------------------------------
# Autonomous Actions
# -----------------------------------------------------------------------------
autonomous_actions:
  enabled: false
  # max_concurrent: 3

# -----------------------------------------------------------------------------
# Daemon
# -----------------------------------------------------------------------------
daemon:
  enabled: false
  # pid_file: spark_daemon.pid
  # heartbeat_interval: 30

# -----------------------------------------------------------------------------
# Voice
# -----------------------------------------------------------------------------
voice:
  # Text-to-speech engine: "browser" (default, offline, robotic) or "elevenlabs".
  engine: browser

  elevenlabs:
    # Stored in the OS keychain, never written to this file.
    api_key: ""
    # eleven_flash_v2_5 (fast, half price) | eleven_multilingual_v2 | eleven_v3
    model_id: eleven_flash_v2_5
    # Used by chat, and as the fallback for any debate/panel agent with no voice.
    default_voice_id: ""
    # Local guard against runaway spend. 0 means unlimited.
    monthly_character_cap: 100000
    # Cached audio replays for free — the same text is never billed twice.
    cache_enabled: true
    cache_max_mb: 200

  # Voice-mode behaviour in debate and panel:
  #   listen_along - speak agent turns; the mic opens only when you have the floor
  #   immersive    - always-on mic, hands-free
  #   listen_only  - narration only; the mic never opens
  interaction_mode: listen_along
